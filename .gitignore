# https://dart.dev/tools/private-files
# Created by `dart pub`
.dart_tool/

# Avoid committing pubspec.lock for library packages; see
# https://dart.dev/tools/pub/private-files#pubspec-lock.
pubspec.lock

# Generated API documentation (`dart doc`).
doc/api/

# Test coverage output.
coverage/

# Credentials. `example/storage/storage_backends.dart` reads
# `service-account.json` from the package root, and anyone testing the S3 or
# GCS backends will have key material lying about — none of it belongs in git.
*.pem
*.key
*.p12
*.pfx
service-account*.json
gcp-*.json
credentials.json
.env
.env.*

# Registry data directories. `omnystore server --data …` and the server
# examples write real artifacts and metadata here.
.omnystore*/
registry/
*.omnystore-partial*

# Editor and OS noise.
.idea/
*.iml
.vscode/
.DS_Store
